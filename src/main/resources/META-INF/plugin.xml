<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.gaphunter.openapicompanion</id>
    <name>OpenAPI Companion</name>
    <vendor>Gap Hunter Labs</vendor>
    <description><![CDATA[
        <p>$ref navigation and spec checks for OpenAPI and Swagger files in JSON and YAML: go to definition across files, broken references, unused components, and examples that don't match their schema. Resolved against local files only: no Spectral CLI, no account, no network calls.</p>
        <ul>
          <li><b>Go to definition</b> (Ctrl+Click or Ctrl+B) on any <code>$ref</code>, in the same file or in another file of the same format.</li>
          <li><b>Broken references:</b> every <code>$ref</code> that doesn't resolve is flagged, with a specific explanation when it uses the other version's convention (<code>#/definitions/</code> in OpenAPI 3.x, or <code>#/components/</code> in Swagger 2.0).</li>
          <li><b>Unused components:</b> schemas, responses, parameters, examples, request bodies, headers, links and callbacks that nothing references are grayed out, like unused code.</li>
          <li><b>Examples checked against their schema:</b> <code>example</code> and <code>default</code> values are validated, including OpenAPI 3.1 type unions, OpenAPI 3.2 documents and formats such as <code>date-time</code>, <code>uuid</code> and <code>email</code>.</li>
        </ul>
        <p>Not supported yet: a <code>$ref</code> from a JSON file into a YAML file, or the other way around.</p>
        <p>Paid plugin with a free trial. Licenses for one developer or a whole team are on the Pricing tab.</p>
        <p><a href="https://github.com/GapHunterLabs/openapi-companion">Documentation</a> · <a href="https://github.com/GapHunterLabs/openapi-companion/issues">Report an issue</a></p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>
    <depends>org.jetbrains.plugins.yaml</depends>

    <!-- Real product code assigned by JetBrains Marketplace on enrolling this
         plugin in the Paid pricing model (2026-08-04). No optional="true":
         unlike every Freemium plugin in this catalog, this is 100% Paid, no
         free tier, the base plugin itself requires a license, not just one
         extra feature. release-version must share leading digits with the
         plugin's own version, which is why this build moved from 0.1.0 to
         the AAAA.N.N scheme (same forcing function already hit once with
         ansible-companion's Freemium enrollment). -->
    <product-descriptor code="POPENAPICOMPANI" release-date="20260926" release-version="20264"/>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="OpenAPI Companion" displayType="BALLOON"/>
        <psi.referenceContributor language="JSON"
                                   implementation="dev.gaphunter.openapicompanion.reference.JsonOpenApiRefReferenceContributor"/>
        <psi.referenceContributor language="yaml"
                                   implementation="dev.gaphunter.openapicompanion.reference.YamlOpenApiRefReferenceContributor"/>
        <annotator language="JSON" implementationClass="dev.gaphunter.openapicompanion.highlighting.OpenApiRefAnnotator"/>
        <annotator language="yaml" implementationClass="dev.gaphunter.openapicompanion.highlighting.OpenApiRefAnnotator"/>
        <!-- See OpenApiJsonSchemaGtdSuppressor's own doc comment and
             KNOWN_ISSUES.md Round 1: suppresses the bundled JSON Schema
             go-to-declaration handler on recognized OpenAPI files, only
             once licensed, so this plugin's own references get a chance
             to resolve instead of losing to the bundled handler every
             time (GotoDeclarationHandlers run before generic
             PsiReference resolution). -->
        <json.jsonSchemaGotoDeclarationSuppressor implementation="dev.gaphunter.openapicompanion.reference.OpenApiJsonSchemaGtdSuppressor"/>
        <gotoDeclarationHandler implementation="dev.gaphunter.openapicompanion.reference.OpenApiGotoDeclarationHandler"/>
        <localInspection language="yaml" shortName="OpenApiYamlUnusedComponent"
                         displayName="Potentially unused OpenAPI component" groupName="OpenAPI Companion"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="dev.gaphunter.openapicompanion.inspection.OpenApiYamlUnusedComponentInspection"/>
        <localInspection language="JSON" shortName="OpenApiJsonUnusedComponent"
                         displayName="Potentially unused OpenAPI component" groupName="OpenAPI Companion"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="dev.gaphunter.openapicompanion.inspection.OpenApiJsonUnusedComponentInspection"/>
        <localInspection language="yaml" shortName="OpenApiYamlExampleSchema"
                         displayName="Example or default value doesn't match its schema" groupName="OpenAPI Companion"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="dev.gaphunter.openapicompanion.inspection.OpenApiYamlExampleSchemaInspection"/>
        <localInspection language="JSON" shortName="OpenApiJsonExampleSchema"
                         displayName="Example or default value doesn't match its schema" groupName="OpenAPI Companion"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="dev.gaphunter.openapicompanion.inspection.OpenApiJsonExampleSchemaInspection"/>
    </extensions>
</idea-plugin>
